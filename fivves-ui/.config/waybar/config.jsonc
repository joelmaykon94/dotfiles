{
  "reload_style_on_change": true,
  "output": ["*"],
  "layer": "top",
  "position": "top",
  "spacing": 0,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "clock",
    "tray"
  ],

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "󰃢",
      "1": "󰖟",
      "2": "",
      "3": "󰎞",
      "4": "",
      "5": "",
      "6": "6",
      "7": "7",
      "8": "8",
      "9": "9"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "hyprland/window": {
    "format": "{title} - {class}",
    "max-length": 50,
    "rewrite": {
      "^ - $": "󰟒 Desktop",
      "^(.*?)( - Chromium| — Chromium)? - chrome.*$": " $1",
      "(.*) - Obsidian - .* - obsidian": " $1",
      "(.*nvim)...(.*)": " $2",
      "(.*code) - (.*)": "󰨞 $1",
      "^.*btop( .*|$)": "󰧨 BTOP$1",
      "^.*unimatrix( .*|$)": "󰘨 MATRIX$1",
      "(.*) - Spotify": " $1",
      "(.*) - mpv - mpv": "󰕧 $1",
      "(.*) - com.mitchellh.ghostty": "󰊠 $1",
      "(.*) - Alacritty": "  $1",
      "(.*) - kitty": " $1",
      "(.*) - BeeperTexts": " 󰻞 $1",
      "(.*Discord)...(.*).. (.*)": " $2",
      "(.*) - org.gnome.Nautilus": "󰉓 $1",
      "(.*) - fish": "  [$1]",
      "(.*Steam)...(.*)": " $1",
      "(.*imv)...(.*).. (.*)": " $2",
      "(.*) - com.obsproject.Studio": " $1",
      "^(.*?)( — Zen Browser)? - zen$": " $1",
      "^(.*?)( - Sublime Text.*)? - sublime_text$": "󰈙 $1",
      "^(.*) - Outlook - outlook-for-linux$": "󰴢 $1",
      "^(.*) \\| (Microsoft )?Teams - teams-for-linux$": "󰊻 $1",
      "^(.*?)( - G4Music)? - com\\.github\\.fivves\\.gapless$": " $1",
      "^(.*) - com\\.jeffser\\.Nocturne$": " $1",
      "^(.*) - WhatsApp Desktop$": " $1"
    }
  },

  "pulseaudio": {
    "format": "{icon}",
    "on-click": "$TERMINAL --class=Wiremix -e wiremix",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    }
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "omarchy-launch-wifi"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{capacity}% {icon}",
    "format-charging": "{capacity}% {icon}",
    "format-plugged": " {capacity}%",
    "format-full": "󰂅",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "on-click-right": "notify-send -u low \"$(omarchy-battery-status)\"",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "clock": {
    "format": "󰃰 {:%a %b %d %I:%M %p}",
    "tooltip": false,
    "on-click": "omarchy-launch-or-focus-webapp Calendar 'https://calendar.notion.so/'",
    "on-click-right": "omarchy-cmd-tzupdate"
  },

  "tray": {
    "icon-size": 12,
    "spacing": 12
  }
}
